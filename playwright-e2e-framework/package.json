{
  "name": "playwright-e2e-framework",
  "version": "1.0.0",
  "description": "Scalable E2E web automation framework using Playwright, JavaScript, Page Object Model, and GitHub Actions CI/CD",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:auth": "playwright test tests/auth.spec.js",
    "test:inventory": "playwright test tests/inventory.spec.js",
    "test:checkout": "playwright test tests/checkout.spec.js",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install --with-deps"
  },
  "keywords": [
    "playwright",
    "e2e",
    "automation",
    "testing",
    "page-object-model",
    "ci-cd"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
